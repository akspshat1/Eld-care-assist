# Copy this file to .env and put your real key in it.
#
#     cp .env.example .env
#
# .env is gitignored, so your keys are never committed.
# Get a free Groq key at https://console.groq.com/keys
#
# Only GROQ_API_KEY is required. Everything else has a working default --
# the values shown commented out below ARE the defaults, so uncomment a line
# only when you want to change it.

GROQ_API_KEY=your_groq_api_key

# GROQ_BASE_URL=https://api.groq.com/openai/v1


# ---------------------------------------------------------------------------
# ORCAROUTER -- optional.
# Used only to generate reports from recorded data (daily report, family
# digest, conversation-to-record extraction). Everything else uses Groq.
# If OrcaRouter is unreachable, those call sites fall back to Groq, so leaving
# this unset costs you nothing.
# ---------------------------------------------------------------------------
ORCAROUTER_API_KEY=your_orcarouter_api_key

# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# ECA_REPORT_MODEL=orcarouter/auto


# ---------------------------------------------------------------------------
# MODELS AND TUNING
# Model IDs change over time. If you get a "model not available" error, open
# the Settings tab in the app to list the models your key can actually use.
# ---------------------------------------------------------------------------

# Conversation, summaries, check-in write-ups
# ECA_TEXT_MODEL=llama-3.3-70b-versatile

# Reading prescription photos (must support vision)
# ECA_VISION_MODEL=qwen/qwen3.6-27b

# Speech to text
# ECA_WHISPER_MODEL=whisper-large-v3-turbo

# ECA_TIMEOUT_SEC=60
# ECA_IMAGE_MAX_SIDE=1200


# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
# PIN for the care team / family / medicines / report views. The resident's
# own screens are never locked. Leave unset and nothing is locked -- a
# forgotten PIN must not keep a caregiver from a medication schedule.
# CARE_PIN=1234

# Key used to encrypt stored voice recordings. Generated into .env
# automatically on first run if absent; losing it makes existing recordings
# unreadable. Never commit the real value.
# AUDIO_KEY=generated_automatically_on_first_run

# Voice recordings are deleted after this many days (0 = keep forever).
# AUDIO_RETENTION_DAYS=30


# ---------------------------------------------------------------------------
# URGENT ALERTS -- how "grandma reported chest pain" reaches a real person.
# All optional. With none set, alerts are still recorded and shown in the app,
# and the UI says plainly that nothing was sent.
# ---------------------------------------------------------------------------

# WEBHOOK (quickest to demo). Any URL taking a JSON POST -- a Discord or Slack
# incoming webhook works with no code:
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# EMAIL. For Gmail use an App Password, not your normal password:
#   Google Account > Security > 2-Step Verification > App passwords
# The alert goes to the "email" field of each contact you add in the app.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password
# ALERT_FROM=you@gmail.com

# SMS via Twilio (needs a paid number)
# TWILIO_SID=ACxxxxxxxx
# TWILIO_TOKEN=xxxxxxxx
# TWILIO_FROM=+15551234567


# ---------------------------------------------------------------------------
# FAMILY DASHBOARD THRESHOLDS -- what the family gets told about.
# ---------------------------------------------------------------------------
# Wellbeing score at or below this raises a concern
# FAM_LOW_WELLBEING=40

# Hours of no interaction before the family is notified
# FAM_QUIET_HOURS=36

# Missed doses in a row before the family is notified
# FAM_MISSED_DOSES=2
